rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens dos banners da tela de rastreio público — precisam ser lidas
    // sem login (mesma tela pública) e só devem ser escritas pelo painel
    // admin. Regras de Storage não conseguem consultar o Realtime Database
    // pra checar "tipo === master" (isso é feito no client-side, igual o
    // resto do painel admin já faz hoje) — aqui só garantimos que é alguém
    // autenticado, e limitamos a imagens de até 5MB.
    match /banners/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Anexos de chamados de suporte (2026-09-29): só o dono do chamado
    // escreve na própria pasta ({uid} no caminho); leitura exige login
    // (mesmo padrão "autenticado é o mínimo aceitável" já usado em vários
    // nós do database.rules.json) — Storage rules não conseguem checar
    // "tipo === master" no Realtime Database, então não dá pra restringir
    // a leitura só ao dono+master aqui, igual a escrita.
    match /chamados/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Documentos de verificação do entregador — comprovante de endereço,
    // CNH, documento do veículo (2026-10-08, pedido do dono: prevenir
    // roubo/furto/golpe limitando quem pode aceitar rotas a quem já
    // verificou a documentação). Bem mais sensível que chamados (são
    // documentos de identidade), por isso a leitura aqui é SÓ do dono —
    // diferente de chamados, não relaxa pra "qualquer autenticado". O
    // painel master não precisa de permissão de leitura aqui: ele enxerga o
    // arquivo pela downloadURL com token que o PRÓPRIO entregador gerou no
    // upload e que fica salva em usuarios/{uid}/documentos/{tipo}/url (ver
    // database.rules.json) — esse token já embute a autorização,
    // independente da regra de "read" abaixo.
    match /documentosEntregador/{uid}/{arquivo} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png)');
    }

    // Tudo o mais fica bloqueado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
