{
  "rules": {
    ".read": false,
    ".write": false,

    // Plano de segurança 2026-09-27 (Fase 3): até aqui, `usuarios/.read` era
    // `auth != null` — o Firebase não devolve leitura "podada" (se o caminho
    // exato pedido não tem permissão própria, nega tudo, mesmo com regras
    // mais específicas nos filhos), então isso liberava financeiro/dívida/
    // saques/clientes de QUALQUER usuário pra QUALQUER autenticado, sempre
    // que algo lia `usuarios` (coleção inteira) ou `usuarios/{uid}` (nó de
    // outra pessoa) de uma vez. A ESCRITA nunca dependeu disso (sempre foi
    // dono-ou-master) — isso já era proteção real. O que faltava era achar,
    // pra cada leitura ampla existente, um jeito de não precisar mais dela:
    // o único caso real era `carregarMarketplaceRotasEntregador` (lista de
    // fretes do entregador, varria `usuarios` inteira) — agora resolvido por
    // `marketplacePublico` (índice espelhado por Cloud Function, ver
    // backend/functions/index.js), que só expõe o que o marketplace já
    // mostrava. Painel master (`renderDashboardMaster`/`adminCarregarPacotes`)
    // continua lendo `usuarios` inteira, e continua liberado porque quem
    // chama é master de verdade.
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'master'",
      "$uid": {
        // Cada um lê o próprio nó inteiro numa tacada só (login, perfil,
        // etc) — master também, via ".read" do nível acima (regras do
        // Firebase concedem leitura se QUALQUER nível no caminho permitir).
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",

        // Perfil "público" do app: nome/loja/foto/tipo/status/endereço
        // precisam ser legíveis por qualquer usuário autenticado porque o
        // marketplace, o chat e o cálculo de rota dependem de ver o perfil de
        // OUTRO usuário. Não inclui financeiro nem clientes.
        "nome": { ".read": "auth != null" },
        "loja": { ".read": "auth != null" },
        "foto": { ".read": "auth != null" },
        "logo": { ".read": "auth != null" },

        // Mesmo nível de exposição que já existia (não é regressão nova):
        // o card de "entregador ativo" numa rota em andamento mostra o botão
        // de ligar/WhatsApp pro lojista, então precisa ler o whatsapp de
        // OUTRO usuário (o entregador) — ver renderCardEntregadorAtivoRota
        // (linha ~13751 do frontend).
        "whatsapp": { ".read": "auth != null" },

        // FALHA CORRIGIDA 2026-09-27 (a mais grave encontrada até hoje): antes
        // "tipo" só herdava a regra genérica do $uid ("dono escreve o que
        // quiser no próprio nó"), então QUALQUER conta logada conseguia virar
        // master sozinha rodando db.ref('usuarios/MEU_UID/tipo').set('master')
        // no console — o que também anulava a única checagem de "master" que
        // as regras de financeiro/saques faziam de verdade.
        //
        // Minha primeira tentativa de correção (usar `root.child(...).val()
        // === 'master'` pra checar "quem já é master pode mudar") tinha um
        // bug sutil e CONFIRMADO NA PRÁTICA: `root`/`newData` refletem o
        // estado DEPOIS da própria escrita — então checar `root` no MESMO
        // caminho que está sendo escrito é auto-referente (a escrita "eu sou
        // master" se autoaprova, porque no momento da checagem o valor
        // hipotético já É 'master'). `.validate` não tem essa armadilha
        // porque `data`/`newData` aqui são sempre relativos a ESTE campo
        // específico, nunca a `root`.
        //
        // Solução final: tipo só pode ser gravado UMA VEZ (cadastro inicial,
        // nunca 'master'/'admin' — só 'loja'/'entregador'/'cliente'). Depois
        // de existir, nenhuma escrita de cliente muda esse valor nunca mais —
        // qualquer promoção a master precisa passar por fora do app (Cloud
        // Function com Admin SDK, que ignora estas regras, ou console do
        // Firebase), nunca por uma escrita comum autorizada por regra.
        "tipo": {
          ".read": "auth != null",
          ".write": "$uid === auth.uid",
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() !== 'master' && newData.val() !== 'admin')"
        },
        "status": { ".read": "auth != null" },
        "endereco": { ".read": "auth != null" },

        // Dinheiro é a parte mais sensível do app. Dono lê/escreve; master/admin
        // também lê e ESCREVE (necessário: marcarSaqueComoPago debita o saldo
        // de OUTRO usuário quando o master confirma o pagamento do saque —
        // sem isso a escrita caía em PERMISSION_DENIED e o saque nunca saía
        // de "solicitado", mesmo o master confirmando. BUG CORRIGIDO
        // 2026-09-19, mesma política que 'saques' logo abaixo). Cloud
        // Functions usam o Admin SDK e ignoram estas regras de qualquer forma.
        "financeiro": {
          ".read": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master' || root.child('usuarios').child(auth.uid).child('tipo').val() === 'admin'",
          ".write": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master' || root.child('usuarios').child(auth.uid).child('tipo').val() === 'admin'"
        },

        // Dados pessoais dos clientes finais do lojista (nome, telefone,
        // endereço) — nunca devem ser legíveis por outro usuário além do
        // próprio lojista ou um master.
        "clientes": {
          ".read": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master' || root.child('usuarios').child(auth.uid).child('tipo').val() === 'admin'",
          ".write": "$uid === auth.uid",

          // BUG CORRIGIDO 2026-09-18: `historico[]` guarda o ENVIO no modelo
          // antigo (status, rotaId, etc — mesma função de usuarios/*/pacotes),
          // não é dado de perfil do cliente. Aceitar rota, confirmar entrega,
          // devolução e cobrança na entrega TODOS escrevem aqui a partir da
          // sessão do ENTREGADOR (outro uid) — com a regra de cima (dono
          // apenas) isso negava a escrita e travava a função no meio,
          // deixando a rota dessincronizada entre lojista e entregador
          // (a cópia do lojista virava EM_ROTA, a do entregador nunca era
          // criada). Mesma política de auth!=null que já vale pra
          // usuarios/*/pacotes.
          "$clienteId": {
            "historico": {
              ".write": "auth != null"
            }
          }
        },

        // Escrito por OUTRO usuário (lojista notifica entregador e vice-versa),
        // por isso a escrita não pode ser só do dono.
        "notificacoes": {
          ".read": "$uid === auth.uid",
          ".write": "auth != null"
        },

        // Ainda não valida se quem escreve é de fato um dos dois participantes
        // da rota daquele chat (exigiria consultar a rota dentro da regra) —
        // aceitável por agora, mensagem de chat não é dado financeiro, mas é a
        // próxima coisa a apertar.
        "chats": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        // Entregador precisa gravar aqui no pacote de OUTRO usuário (confirmar
        // entrega, devolução, cobrança na entrega) — autenticado é o mínimo
        // aceitável agora; checar vínculo real com a rota é o próximo passo.
        "pacotes": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        // Entregador aceita/atualiza rota de OUTRO usuário; marketplace lê
        // rotas de todo mundo pra montar a lista de fretes disponíveis.
        "rotas": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "metaDiaHistorico": { ".read": "$uid === auth.uid", ".write": "$uid === auth.uid" },
        "entregadorMetaDia": { ".read": "$uid === auth.uid", ".write": "$uid === auth.uid" },

        // Pedidos de saque (solicitação manual via Pix, ver solicitarSaque no
        // app). O dono cria/lê os próprios; um master também precisa poder ler
        // e ATUALIZAR (marcar como pago) o saque de OUTRO usuário — por isso a
        // escrita não é só do dono aqui, ao contrário do resto do node.
        "saques": {
          ".read": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master' || root.child('usuarios').child(auth.uid).child('tipo').val() === 'admin'",
          ".write": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master' || root.child('usuarios').child(auth.uid).child('tipo').val() === 'admin'"
        },

        // Taxa de espera/subida (2026-09-25, ver criarDividaLojistaEntregador):
        // o ENTREGADOR grava aqui (na conta do LOJISTA) quando o cliente não
        // paga a taxa em dinheiro na hora — por isso não pode ser só o dono
        // escrevendo, igual pacotes/rotas logo abaixo.
        "dividasEntregador": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        // Espelho do lado do entregador — ele mesmo cria (ao gerar a dívida
        // acima) e confirma quando recebe (ver confirmarRecebimentoTaxaEntregador).
        "taxasAReceber": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        // Chamados de suporte (2026-09-29): dono cria/lê os próprios; master
        // também precisa ler e ATUALIZAR (responder/fechar) o chamado de
        // OUTRO usuário — mesmo padrão de "saques" acima.
        "chamados": {
          ".read": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master'",
          ".write": "$uid === auth.uid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'master'"
        }
      }
    },

    // Coleção legada duplicada fora de /usuarios (modelo antigo). Mesma
    // política de "autenticado apenas" até ser migrada/removida — ver memória
    // project-flexa-cobranca-entrega-dinheiro sobre o modelo duplicado.
    "pacotes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // Índice público do marketplace (plano de segurança 2026-09-27, Fase 3):
    // espelho gerado só pelos triggers marketplacePublicoUsuarios/
    // marketplacePublicoPacotesRaiz (Admin SDK, backend/functions/index.js)
    // a partir de usuarios/{uid}, contendo só os campos que o marketplace do
    // entregador já mostrava antes de apertar usuarios/.read — nunca
    // financeiro/dívida/saques/dados de identificação do cliente final.
    // Cliente nunca escreve aqui direto.
    "marketplacePublico": {
      ".read": "auth != null",
      ".write": false
    },

    // Tokens de login automático do cliente final via link de rastreio
    // (plano 2026-09-28, ver gerarLoginCliente/consumirLoginCliente em
    // backend/functions/index.js). O cliente que clica no link ainda não
    // tem NENHUM token de autenticação — a prova de identidade é o próprio
    // valor aleatório do loginToken, então ninguém (nem autenticado) pode
    // ler ou escrever aqui direto, só as duas Cloud Functions via Admin SDK.
    "loginTokens": {
      ".read": false,
      ".write": false
    },

    // Só os Cloud Functions tocam aqui via Admin SDK, que ignora estas regras
    // — isto bloqueia qualquer acesso direto do cliente, inclusive leitura.
    "mp_payments": {
      ".read": false,
      ".write": false
    },

    "presence": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // Login passou a ser por WhatsApp (2026-09-20): o Firebase Auth só sabe
    // logar por e-mail, então esse índice resolve numero -> e-mail ANTES do
    // login acontecer — por isso ".read" tem que ser público (nesse momento
    // ainda não existe auth.uid pra checar nada). O e-mail sozinho não deixa
    // ninguém entrar sem saber a senha também, então o risco real aqui é só
    // alguém confirmar "esse número tem conta" testando números ao acaso —
    // aceitável, não é dado sensível igual senha/saldo. A escrita exige que a
    // pessoa esteja logada E que o valor gravado seja o e-mail da PRÓPRIA
    // conta dela (impede logado sequestrar o número de outra conta).
    "telefoneParaEmail": {
      "$telefone": {
        ".read": true,
        ".write": "auth != null && newData.val() === root.child('usuarios').child(auth.uid).child('email').val()"
      }
    },

    // ===== [RASTREIO PÚBLICO DO CLIENTE FINAL] (2026-09-20) =====
    // Link de rastreio (ex: #/rastreio/<token>) acessado SEM LOGIN pelo
    // cliente final. Mesma lógica do telefoneParaEmail: em vez de abrir a
    // rota/pacote de verdade pra leitura pública (o que vazaria endereço e
    // dados de OUTROS clientes da mesma rota), a gente mantém uma cópia à
    // parte só com o mínimo necessário pro cliente ver o progresso do PRÓPRIO
    // envio (status, localização do entregador, ETA). token é aleatório
    // (crypto.randomUUID), então só quem tem o link específico acha o
    // rotaId/pacoteId por trás dele.
    "rastreioToken": {
      "$token": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    // Um nó por rota (não por pacote) pra não multiplicar as escritas de GPS
    // a cada 15s por N pacotes da mesma rota — todo pacote daquela rota lê o
    // mesmo nó e pega só a própria linha dentro de "pacotes".
    "rastreioPublico": {
      "$rotaId": {
        ".read": true,
        ".write": "auth != null",

        // Taxa de subida (2026-09-25): o CLIENTE pede pelo link público, sem
        // login nenhum — por isso esses dois campos específicos precisam
        // aceitar escrita sem auth (o resto do nó continua exigindo login,
        // igual antes). Só um booleano + timestamp; nenhum dado sensível ou
        // financeiro real muda de mãos aqui, o valor em si só é cobrado
        // depois que o ENTREGADOR aceita, do lado dele.
        "pacotes": {
          "$pacoteId": {
            "subirStatus": { ".write": true },
            "subirSolicitadoEm": { ".write": true }
          }
        }
      }
    },

    // Banners de publicidade da tela de rastreio público — gerenciados pelo
    // master no painel admin, lidos sem login (mesma tela pública acima).
    "banners": {
      ".read": true,
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'master'"
    },

    // ===== [IDENTIDADE GLOBAL DO CLIENTE FINAL] (2026-09-21) =====
    // Índice compartilhado nome+whatsapp -> qualquer lojista logado consegue
    // achar um cliente que já foi cadastrado por OUTRA loja (em vez de cada
    // loja ter sua própria lista isolada e nunca se encontrarem). Só guarda
    // o mínimo (nome, whatsapp, uid, status de cadastro) — endereço mora à
    // parte em clientesGlobaisPerfil (ver abaixo), com leitura restrita a
    // autenticados, já que é dado bem mais sensível.
    // LEITURA pública (2026-09-26, bug corrigido): convidarClienteParaApp/
    // cadastrarClienteRastreio precisam checar isso ANTES de logar em
    // qualquer conta na instância secundária (ver obterClienteAuth) — nesse
    // momento ela está deslogada, então "auth != null" negava a leitura
    // silenciosamente e travava o reenvio de convite. Não é dado sensível
    // (só nome+whatsapp+uid+status), mesmo nível de exposição que
    // telefoneParaEmail/rastreioToken logo abaixo.
    // uid/cadastroCompleto (2026-10-02): só a própria conta-cliente dona do
    // uid pode gravar esses dois campos — mesma ideia do write-once de
    // usuarios/$uid/tipo (usa `data`/`newData`, nunca `root`, pra não cair
    // na armadilha de regra auto-referente). Antes, `.write: auth != null`
    // sem essa trava deixava qualquer autenticado sequestrar o vínculo de
    // conta de um telefone que não é o dele.
    "clientesGlobais": {
      "$telefone": {
        ".read": true,
        ".write": "auth != null",
        "uid": {
          ".write": "!data.exists() || newData.val() === auth.uid || data.val() === auth.uid"
        },
        "cadastroCompleto": {
          ".write": "!data.parent().child('uid').exists() || data.parent().child('uid').val() === auth.uid"
        }
      }
    },

    // ===== [PERFIL REUTILIZÁVEL DO CLIENTE FINAL] (2026-10-02) =====
    // Cartão de contato completo (endereço/geo) pra um lojista reaproveitar
    // um cliente já cadastrado por OUTRA loja, buscando pelo WhatsApp EXATO
    // (ver buscarClienteGlobalEExibir) — nunca uma lista navegável, só uma
    // leitura de chave exata. Pedido do dono 2026-10-02: evitar que isso vire
    // um banco de contatos pra marketing entre lojistas. Diferente do nó
    // acima, este carrega endereço, por isso exige login pra ler (o nó
    // acima precisa ficar público pro autocadastro do cliente, que roda
    // deslogado; este nunca é lido nesse fluxo).
    "clientesGlobaisPerfil": {
      "$telefone": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    // ===== [CONTA DO CLIENTE FINAL — MEUS PEDIDOS] (2026-09-24) =====
    // Índice mínimo telefone -> {token de rastreio, loja, data} pra tela
    // "Meus pedidos" do cliente logado (ver renderMeusPedidosCliente em
    // legacy-monolith.js) montar a lista de pedidos em QUALQUER loja parceira
    // sem precisar ler os dados reais de cada lojista (que continuam
    // isolados e privados). Cada item aponta pra um rastreioToken já público
    // por si só, então não vaza nada de novo.
    "pedidosPorCliente": {
      "$telefone": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
